                window_size=window_sizes,
                step=steps,
                gencode_version=gencode_version,
                tumor_type_IntOGen=tumor_type_IntOGen
        ),
        expand(
            "data/distances/OG/{assembly_code}_{window_mode}_{window_size}_{step}_v{gencode_version}_{tumor_type_IntOGen}",
                assembly_code=assembly_code,
                window_mode=window_mode,
                window_size=window_sizes,
                step=steps,
                gencode_version=gencode_version,
                tumor_type_IntOGen=tumor_type_IntOGen
        ),
        expand(
            "data/epigenomes/{tissue_type_Roadmap}_{sample_type}_{liftover_str}_{file_format}_{assembly_code}_{window_mode}_{window_size}_{step}",
                tissue_type_Roadmap=tissue_type_Roadmap,
                sample_type=sample_type,
                liftover_str=liftover_str,
                file_format=file_format,
                assembly_code=assembly_code,
                window_mode=window_modes,
                window_size=window_sizes,
                step=steps
        )

wildcard_constraints:
    assembly_code = "hg\\d{2}",
    gencode_version="[0-9]+",
    tss_subset="[a-z]+",
    window_size = "[0-9]+",
    step = "[0-9]+",
    window_mode = "[a-z]+",
    tumor_type_IntOGen = "[A-Z]+"
    
