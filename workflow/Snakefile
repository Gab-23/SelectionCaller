def get_epigenome_ids(wildcards, tissue_type_Roadmap):

    mapping_file = checkpoints.get_mapping_EID_tt.get(**wildcards).output[0]
    mapping = pandas.read_csv(mapping_file, sep = "\t", header = 0)
    
    tissue_type = [tissue_type_Roadmap] if tissue_type_Roadmap != "anyTissue" else mapping.tissue_type.tolist()
    sample_type = config["sample_types"] if config["sample_types"][0] != "anySample" else mapping.sample_type.tolist()
    
    epigenome_ids = mapping[((mapping.tissue_type.isin(tissue_type)) & (mapping.sample_type.isin(sample_type)))]["epigenome_id"].tolist()
    
    if len(epigenome_ids) == 0:
        raise ValueError("Empty DataFrame")
    else:
        return epigenome_ids

def map_tt_acronym(mapping_file_location, tumor_type):
    try:
        mapping = pandas.read_csv(mapping_file_location, header = 0, sep = "\t")
        tissue_type_Roadmap = mapping[mapping.common_name == tumor_type].tissue_type_Roadmap.values[0]
        tumor_type_IntOGen = mapping[mapping.common_name == tumor_type].tumor_type_IntOGen.values[0]
        return [tissue_type_Roadmap, tumor_type_IntOGen]
    except FileNotFoundError as err:
        print(f"{mapping_file_location} does not exist")

mapping_file_tt_locations = config["mapping_file_tt_locations"]

assembly_codes = config["assembly_codes"]
gencode_versions = config["gencode_versions"]

sample_types = config["sample_types"]
file_formats = config["file_formats"]

window_sizes = config["window_sizes"]
window_modes = config["window_modes"]
steps = config["steps"]

tumor_types = config["tumor_types"]

IntOGen_locations = config["IntOGen_locations"]
cohorts = config["cohorts"]

##### 

if len(mapping_file_tt_locations) > 1:
    raise ValueError("ERROR, multiple mapping_file_location selected")
else:
    mapping_file_tt_location = mapping_file_tt_locations[0]

if len(assembly_codes) > 1:
    raise ValueError("ERROR, multiple assemblies selected")
else:
    assembly_code = assembly_codes[0]
    is_liftover = True if assembly_code == "hg38" else False
    liftover_str = "hg38lift" if is_liftover else "noliftover"

if len(gencode_versions) > 1:
    raise ValueError("ERROR, multiple gencode_versions selected")
else:
    gencode_version = gencode_versions[0]

if len(sample_types) > 1:
    raise ValueError("ERROR, multiple sample types selected")
else:
    sample_type = sample_types[0]

if len(file_formats) > 1:
    raise ValueError("ERROR, multiple file formats selected")
else:
    file_format = file_formats[0]

if len(window_modes) > 1:
    raise ValueError("ERROR, multiple window_modes selected")
else:
    window_mode = window_modes[0]
    if window_mode not in ["sliding", "s", "binned", "b"]:
        raise ValueError(f"ERROR, window_mode must be either 'binned' or 'sliding' [{window_mode}]")

if window_mode == "binned" and any([step > 0 for step in steps]):
    raise ValueError(f"ERROR, steps ({steps}) cannot be > 0 when window_mode is {window_mode}")
else:
    window_mode = window_modes[0]

if len(tumor_types) > 1:
    raise ValueError("ERROR, multiple tumor_types selected")
else:
    tumor_type = tumor_types[0]

if len(IntOGen_locations) > 1:
    raise ValueError("ERROR, multiple IntOGen_locations selected")

if len(cohorts) > 1:
    raise ValueError("ERROR, multiple cohorts selected")

#####

tissue_type_Roadmap, tumor_type_IntOGen = map_tt_acronym(mapping_file_tt_location, tumor_type)

rule all:
    input:
        expand(
            "data/distances/telomeres/{assembly_code}_{window_mode}_{window_size}_{step}",
                assembly_code=assembly_code,
                window_mode=window_mode,
                window_size=window_sizes,
                step=steps
        ),
        expand(
            "data/distances/centromeres/{assembly_code}_{window_mode}_{window_size}_{step}",
                assembly_code=assembly_code,
                window_mode=window_mode,
                window_size=window_sizes,
                step=steps
        ),
        expand(
            "data/GC/{assembly_code}_{window_mode}_{window_size}_{step}",
                assembly_code=assembly_code,
                window_mode=window_mode,
                window_size=window_sizes,
                step=steps 
        ),
        expand(
            "data/num_overlaps/PC/{assembly_code}_{window_mode}_{window_size}_{step}_v{gencode_version}",
                assembly_code=assembly_code,
                window_mode=window_mode,
                window_size=window_sizes,
                step=steps,
                gencode_version=gencode_version
        ),
        expand(
            "data/distances/PC/{assembly_code}_{window_mode}_{window_size}_{step}_v{gencode_version}",
                assembly_code=assembly_code,
                window_mode=window_mode,
                window_size=window_sizes,
                step=steps,
                gencode_version=gencode_version
        ),
        expand(
            "data/distances/TSG/{assembly_code}_{window_mode}_{window_size}_{step}_v{gencode_version}_{tumor_type_IntOGen}",
                assembly_code=assembly_code,
