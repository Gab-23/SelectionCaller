wildcard_constraints:
    step = "[0-9]+"

assembly_codes = config["assembly_codes"]
window_sizes = config["window_sizes"]
steps = config["steps"]

file_format = config["file_format"]
is_liftover = config["is_liftover"]

def get_epigenome_ids(wildcards):
    mapping_file = checkpoints.get_mapping_eID_tt.get(**wildcards).output[0]
    mapping = pd.read_csv(mapping_file, sep = "\t", header = 0)
    tissue_type = config["tissue_type"] if config["tissue_type"][0] != "pancancer" else mapping.tissue_type.tolist()
    epigenome_ids = mapping[mapping.tissue_type.isin(tissue_type)]["epigenome_id"].tolist()
    return epigenome_ids

rule all:
    input:
        filter_bb = expand(
            "resources/{assembly_code}_{window_mode}_{window_size}_{step}_filtered_backbone.tsv",
            assembly_code = assembly_codes, 
            window_mode = "o", 
            window_size = window_sizes, 
            step = steps
        ) +
        expand(
            "resources/{assembly_code}_{window_mode}_{window_size}_{step}_filtered_backbone.tsv",
            assembly_code = assembly_codes, 
            window_mode = "no", 
            window_size = window_sizes, 
            step = 0
        ),
        get_epigenomes_files =  expand(
            "resources/roadmap_epigenomes_download_log_{tissue_type}_{is_liftover}_{file_format}",
            tissue_type = config["tissue_type"], 
            is_liftover = is_liftover, 
            file_format = file_format
        )