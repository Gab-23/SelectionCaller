import pandas as pd

def get_epigenome_ids(wildcards):

    mapping_file = checkpoints.get_mapping_eID_tt.get(**wildcards).output[0]
    mapping = pd.read_csv(mapping_file, sep = "\t", header = 0)
    
    tissue_type = config["tissue_type"] if config["tissue_type"][0] != "anyTissue" else mapping.tissue_type.tolist()
    sample_type = config["sample_type"] if config["sample_type"][0] != "anySample" else mapping.sample_type.tolist()
    
    epigenome_ids = mapping[((mapping.tissue_type.isin(tissue_type)) & (mapping.sample_type.isin(sample_type)))]["epigenome_id"].tolist()
    
    if len(epigenome_ids) == 0:
        raise ValueError('Empty DataFrame')
    else:
        return epigenome_ids

