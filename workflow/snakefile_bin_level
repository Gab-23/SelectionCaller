        # ---- Phase 1: backbone/core annotations module ----
        # GC content
        expand(
            "data/GC/{assembly_code}_{window_mode}_{window_size}_{step}",
            assembly_code=assembly_code,
            window_mode=window_mode,
            window_size=window_sizes,
            step=steps
        ),
        # distanza da centromeri/telomeri
        expand(
            "data/distances/centromeres/{assembly_code}_{window_mode}_{window_size}_{step}",
            assembly_code=assembly_code,
            window_mode=window_mode,
            window_size=window_sizes,
            step=steps
        ),
        expand(
            "data/distances/telomeres/{assembly_code}_{window_mode}_{window_size}_{step}",
            assembly_code=assembly_code,
            window_mode=window_mode,
            window_size=window_sizes,
            step=steps
        ),
        # overlap/distanza dai geni (PC, lncRNA, miRNA, rRNA)
        expand(
            "data/num_overlaps/PC/{assembly_code}_{window_mode}_{window_size}_{step}_v{gencode_version}",
            assembly_code=assembly_code, window_mode=window_mode,
            window_size=window_sizes, step=steps, gencode_version=gencode_version
        ),
        expand(
            "data/num_overlaps/lncRNA/{assembly_code}_{window_mode}_{window_size}_{step}_v{gencode_version}",
