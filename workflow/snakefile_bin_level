            window_size=window_sizes, step=steps, gencode_version=gencode_version
        ),
        expand(
            "data/num_overlaps/miRNA/{assembly_code}_{window_mode}_{window_size}_{step}_v{gencode_version}",
            assembly_code=assembly_code, window_mode=window_mode,
            window_size=window_sizes, step=steps, gencode_version=gencode_version
        ),
        expand(
            "data/num_overlaps/rRNA/{assembly_code}_{window_mode}_{window_size}_{step}_v{gencode_version}",
            assembly_code=assembly_code, window_mode=window_mode,
            window_size=window_sizes, step=steps, gencode_version=gencode_version
        ),
        expand(
            "data/distances/PC/{assembly_code}_{window_mode}_{window_size}_{step}_v{gencode_version}",
            assembly_code=assembly_code, window_mode=window_mode,
            window_size=window_sizes, step=steps, gencode_version=gencode_version
        ),
        expand(
            "data/distances/lncRNA/{assembly_code}_{window_mode}_{window_size}_{step}_v{gencode_version}",
            assembly_code=assembly_code, window_mode=window_mode,
            window_size=window_sizes, step=steps, gencode_version=gencode_version
        ),
        expand(
            "data/distances/miRNA/{assembly_code}_{window_mode}_{window_size}_{step}_v{gencode_version}",
