def _single(values, label):
    # Uniformato con lo stesso helper di snakefile_ML (vedi TODO #7) - prima era ripetuto
    # ~30 volte come blocco identico "if len(x) > 1: raise ValueError(...) else: y = x[0]",
    # qui centralizzato in un'unica funzione. Comportamento invariato: stesso messaggio
    # d'errore (solo con { } al posto della concatenazione manuale), stesso valore ritornato.
    if len(values) > 1:
        raise ValueError(f"ERROR, multiple {label} selected")
    return values[0]

